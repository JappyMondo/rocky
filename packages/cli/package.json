{
  "name": "rocky",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "Rocky's CLI \u2014 a thin client for the per-developer local daemon.",
  "type": "module",
  "bin": {
    "rocky": "./dist/main.js",
    "rocky-ingress": "./dist/ingress-main.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "@rocky/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "node ../../tools/package-rocky.mjs"
  },
  "publishConfig": {
    "directory": "dist/package"
  },
  "dependencies": {
    "@rocky/daemon": "workspace:*",
    "commander": "^14.0.2"
  }
}
