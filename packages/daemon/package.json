{
  "name": "@rocky/daemon",
  "version": "0.0.0",
  "license": "MIT",
  "description": "The long-running local process: Rocky's local API and web UI on one port.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@rocky/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "zod": "^4.5.4"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "bundle-web"
        ]
      },
      "bundle-web": {
        "dependsOn": [
          "web:build"
        ],
        "command": "node tools/bundle-web.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/apps/web/dist/**/*"
        ],
        "outputs": [
          "{projectRoot}/public"
        ]
      }
    }
  }
}
