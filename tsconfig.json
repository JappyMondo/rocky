{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@rocky/sdk": ["./sdk/index.ts"]
    }
  },
  "include": [".rocky/**/*.ts", "sdk/**/*.ts", "runner/**/*.ts", "alternative/**/*.ts"]
}
